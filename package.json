{
  "name": "jarvis-web-research-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI web research agent built with Node.js, TypeScript, Ollama, Playwright, and LangGraph.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:live-search": "tsx src/tools/live-search-smoke.ts",
    "test:node-version-search": "tsx src/tools/node-version-search-test.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/ollama": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "playwright": "^1.56.0",
    "zod": "^4.1.12",
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
